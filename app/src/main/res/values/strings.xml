    <string name="ob_welcome_title">Probabilities, not promises</string>
    <string name="ob_welcome_body">FootballAI runs its own statistical model on this phone. Nothing is downloaded as a ready-made prediction, and no estimate is presented as a fact.</string>
    <string name="ob_welcome_point_model">Poisson, then Dixon-Coles, then an Elo tilt, scored with Brier score and calibration curves</string>
